RewriteEngine On

# 1. Redirect external requests from /page.html to /page
# Only redirect if it's a direct browser request for a .html file
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 2. Internally rewrite /page to /page.html if the .html file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [L]
